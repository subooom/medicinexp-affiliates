{
  "expo": {
    "name": "MedicineXP Affiliates",
    "slug": "medicinexp-affiliates",
    "version": "1.0.0",

    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicinexp",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medicinexp.affiliates",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },

    "android": {
      "package": "com.medicinexp.affiliates",
      "adaptiveIcon": {
        "backgroundColor": "#110F26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110F26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-background-fetch",
        {
          "minimumInterval": 900
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "307872c3-16aa-4e38-a205-48aa13349fba"
      }
    }
  }
}