{
  "expo": {
    "name": "MedicineXP Affiliates",
    "slug": "medicinexp-affiliates",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicinexp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medicinexp.affiliates",
      "infoPlist": {
        "UIBackgroundModes": [
          "processing"
        ]
      }
    },
    "android": {
      "package": "com.medicinexp.affiliates",
      "adaptiveIcon": {
        "backgroundColor": "#110F26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.ico"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#110F26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice memos after visits."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "color": "#5A3DA8"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take shop photos as proof of visit and to read signboards.",
          "photosPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice memos after visits.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to turn your voice memos into text on your phone.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "307872c3-16aa-4e38-a205-48aa13349fba"
      }
    }
  }
}
